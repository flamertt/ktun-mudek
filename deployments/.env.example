# deployments/.env — Bu dosyayı kopyala ve değerleri doldur:
#   cp deployments/.env.example deployments/.env
#
# .env asla git'e eklenmez (.gitignore'a ekle).

# Sitenin tam adresi (protokol dahil, sonda / olmadan)
SITE_ORIGIN=https://mude.ktun.edu.tr

# MSSQL sa şifresi — en az 8 karakter, büyük/küçük harf + rakam + özel karakter
DB_SA_PASSWORD=Str0ng!Passw0rd#2026

# MÜDEK JWT imzalama anahtarı — en az 32 karakter, rastgele ve güçlü olmalı
JWT_SECRET_KEY=mudek-dev-jwt-secret-key-2026-minimum32chars!!

# KTUN LoginKontrolWithUser Basic Auth — usrMudek servis hesabı
# Kullanıcının okul bilgileriyle karıştırılmaz; sadece servis kimliği için kullanılır
KTUN_BASIC_AUTH_USERNAME=
KTUN_BASIC_AUTH_PASSWORD=

# KTUN token dönen login endpointi için servis hesabı
KTUN_SERVICE_USERNAME=
KTUN_SERVICE_PASSWORD=
